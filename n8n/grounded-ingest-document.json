        "jsCode": "const body = $input.first().json.body || {};\nconst filename = typeof body.filename === 'string' ? body.filename.trim() : '';\nconst text = typeof body.text === 'string' ? body.text : '';\nlet error = '';\nif (!filename) error = 'filename is required, e.g. \"notes.md\"';\nelse if (!/\\.(md|txt)$/i.test(filename)) error = 'filename must end in .md or .txt';\nelse if (!text.trim()) error = 'text is required';\nreturn [{ json: { error } }];"
      },
