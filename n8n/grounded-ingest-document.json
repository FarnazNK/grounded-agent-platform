    {
      "parameters": {
        "jsCode": "const slug = $env.GROUNDED_WORKSPACE_SLUG;\nconst list = $input.first().json.workspaces || [];\nconst match = slug ? list.find((m) => m.workspace.slug === slug) : list[0];\nif (!match) {\n  throw new Error(slug ? `No workspace with slug \"${slug}\" for this user` : 'This user has no workspaces');\n}\nreturn [{ json: { workspace_id: match.workspace.id, workspace_slug: match.workspace.slug } }];"
      },
      "name": "Pick workspace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "fdc66bc6-2fc6-5f3d-93aa-75fbc374c205"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst filename = body.filename.trim();\nconst type = filename.toLowerCase().endsWith('.txt') ? 'text/plain' : 'text/markdown';\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(body.text, 'utf8'), filename, type);\nreturn [{ json: { ...$input.first().json, filename }, binary: { file: binary } }];"
      },
