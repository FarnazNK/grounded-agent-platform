APP_ENV=dev
APP_DATABASE_URL=postgresql+psycopg://rag_agent@localhost:5432/rag_agent
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ENABLE_BOOTSTRAP_ADMIN=true
APP_LLM_PROVIDER=deterministic
APP_LLM_MODEL=deterministic-rag
APP_EMBEDDING_PROVIDER=deterministic
APP_EMBEDDING_MODEL=deterministic-embedding
APP_EMBEDDING_DIMENSIONS=256
APP_TOP_K_DENSE=6
APP_TOP_K_SPARSE=6
APP_TOP_K_FINAL=4
APP_DENSE_RETRIEVAL_WEIGHT=0.8
APP_SPARSE_RETRIEVAL_WEIGHT=1.2
APP_MIN_FUSED_SCORE=0.15
APP_CHUNK_SIZE_WORDS=180
APP_CHUNK_OVERLAP_WORDS=30
APP_UPLOAD_MAX_BYTES=2000000
APP_RATE_LIMIT_REQUESTS_PER_MINUTE=60
APP_RETRIEVAL_CACHE_TTL_SECONDS=120
APP_EMBEDDING_CACHE_TTL_SECONDS=3600
APP_LOG_LEVEL=INFO
# Optional LLM tracing with Langfuse (free self-host: monitoring/langfuse/docker-compose.yml)
# pip install -e '.[tracing]'
# APP_TRACING_BACKEND=langfuse
# LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Multi-agent developer team limits
# APP_AGENT_TEAM_MAX_REVIEW_ROUNDS=2
# APP_AGENT_TEAM_MAX_TOTAL_STEPS=40
# Optional LangSmith tracing
# LANGSMITH_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
